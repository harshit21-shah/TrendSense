# API Keys (Required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
NEWS_API_KEY=your_news_api_key

# Reddit OAuth2 (optional but strongly recommended)
# Register a "script" app at https://www.reddit.com/prefs/apps
# Gives 100 req/min vs ~1 req/min unauthenticated RSS
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Database
DATABASE_URL=sqlite+aiosqlite:///trendsense.db

# Vector DB (leave CHROMA_HOST empty for local persistent storage)
CHROMA_HOST=
CHROMA_PORT=8000

# App Config
LOG_LEVEL=INFO
ENVIRONMENT=development

# Pipeline — config-driven, no hardcoded domains
PIPELINE_DOMAINS=AI,Fintech,Health,Biotech,Climate,Crypto
PIPELINE_SCHEDULE_MINUTES=720
PIPELINE_API_KEY=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Notifications
NOTIFICATION_TVS_DELTA_THRESHOLD=5.0
