# =============================================================================
# TrendSense Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=trendsense
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=trendsense_db
DATABASE_URL=postgresql+asyncpg://trendsense:your_secure_password_here@localhost:5432/trendsense_db

# =============================================================================
# API Keys
# =============================================================================

# Groq API (Required) - Get your key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenAI API (Optional) - For alternative LLM support
OPENAI_API_KEY=sk_your_openai_api_key_here

# Reddit API (Required) - Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TrendSense/1.0 by your_username

# NewsAPI (Required) - Get your key at: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# =============================================================================
# ChromaDB Configuration
# =============================================================================
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_URL=http://localhost:8001

# =============================================================================
# Application Configuration
# =============================================================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend
VITE_API_URL=http://localhost:8000
VITE_PIPELINE_API_KEY=

# Pipeline (optional — protects POST /run-pipeline)
PIPELINE_API_KEY=

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================

# Scheduler (cron format)
PIPELINE_SCHEDULE=0 */30 * * *  # Every 30 minutes

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
