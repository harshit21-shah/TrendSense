FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download NLP corpora
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('punkt_tab'); nltk.download('averaged_perceptron_tagger')" || true
RUN python -c "import textblob; textblob.download_corpora()" || true

# Copy app code
COPY . .

# Render injects $PORT at runtime — default to 8000 locally
EXPOSE 8000

# Single worker — required for SQLite (no concurrent writes)
# Use gunicorn with uvicorn workers for production signal handling
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --log-level info
